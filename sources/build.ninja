# Postprocessing  with BuildSTAT
build $
    /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpm3lz3qtc.buildStatstamp: $
    buildSTAT-postprocess ../fonts/variable/Yaldevi[wght].ttf | $
    ../fonts/variable/Yaldevi[wght].ttf
  stamp =  && touch $
      /var/folders/kq/qnbdv5c51zbc56xfr_dtzs680000gn/T/tmpm3lz3qtc.buildStatstamp
  postprocess = buildStat
# Generating ../fonts/webfonts/Yaldevi[wght].woff2
build ../fonts/webfonts/Yaldevi[wght].woff2: compress $
    ../fonts/variable/Yaldevi[wght].ttf
  operation = compress
# Generating ../fonts/webfonts/Yaldevi-ExtraLight.woff2
build ../fonts/webfonts/Yaldevi-ExtraLight.woff2: compress $
    ../fonts/ttf/Yaldevi-ExtraLight.ttf
  operation = compress
